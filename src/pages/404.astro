---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base title="Página no encontrada · Mariyen" description="La página que buscas no existe.">
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
    <span class="text-petroleo"><Logo size={48} /></span>
    <h1 class="titulo text-[clamp(40px,6vw,72px)]">Esta página <em>no existe.</em></h1>
    <a href="/" class="btn btn-primario">Volver al inicio</a>
  </main>
</Base>
