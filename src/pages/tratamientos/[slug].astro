---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaWhatsapp from '../../components/CtaWhatsapp.astro';
import Flecha from '../../components/Flecha.astro';
import { servicios, urlServicio, type Servicio } from '../../data/servicios';
import { WHATSAPP_URL } from '../../data/sitio';

export const getStaticPaths = (() =>
  servicios.map((s) => ({ params: { slug: s.slug }, props: { s } }))) satisfies GetStaticPaths;

interface Props {
  s: Servicio;
}

const { s } = Astro.props;
const otros = servicios.filter((o) => o.slug !== s.slug);
const tonosGaleria = ['#D8CBBE', '#CBBDB0', '#E2D3C8'];

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '#otros', label: 'Tratamientos', activo: true },
  { href: '/#resultados', label: 'Resultados' },
  { href: '/#sede', label: 'Sede' },
];
---

<Base
  title={`${s.nombre} en Zipaquirá · Mariyen Centro de Estética`}
  description={s.intro}
>
  <div class="px-6 pt-4">
    <Header links={navLinks} class="max-w-[1200px] shadow-[0_1px_2px_rgba(31,42,43,0.06)]" />
  </div>

  <main>
    <div class="mx-auto flex max-w-[1200px] flex-col gap-[18px] px-6 pt-7">
      <nav aria-label="Ruta" class="flex flex-wrap gap-2 text-sm text-gris-2">
        <a href="/" class="text-gris-2 underline hover:text-petroleo">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>Tratamientos</span>
        <span aria-hidden="true">/</span>
        <span class="font-semibold text-tinta" aria-current="page">{s.nombre}</span>
      </nav>
      <nav aria-label="Cambiar de tratamiento" class="flex flex-wrap gap-2">
        {
          servicios.map((t) => {
            const activo = t.slug === s.slug;
            return (
              <a
                href={urlServicio(t.slug)}
                aria-current={activo ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-full border px-[18px] py-2.5 text-sm font-semibold no-underline transition-colors',
                  activo
                    ? 'border-petroleo bg-petroleo text-white hover:text-white'
                    : 'border-linea-3 bg-white text-tinta hover:border-petroleo hover:text-petroleo',
                ]}
              >
                {t.nombre}
              </a>
            );
          })
        }
      </nav>
    </div>

    <!-- Hero del servicio -->
    <section
      class="mx-auto grid max-w-[1200px] grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] items-center gap-12 px-6 pt-9 pb-[72px]"
    >
      <div class="flex flex-col gap-[22px]">
        <p class="eyebrow">{s.zona}</p>
        <h1 class="titulo text-[clamp(44px,5.4vw,72px)] tracking-[-0.01em]">
          {s.t1} <em>{s.tItal}</em>
        </h1>
        <p class="m-0 max-w-[500px] text-lg leading-[1.65] text-gris">{s.intro}</p>
        <div class="flex flex-wrap gap-2.5">
          <span class="flex items-center gap-2 rounded-full bg-white px-4 py-2.5 text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F4A4C" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            {s.duracion}
          </span>
          <span class="flex items-center gap-2 rounded-full bg-white px-4 py-2.5 text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F4A4C" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
            {s.frecuencia}
          </span>
          <span class="flex items-center gap-2 rounded-full bg-white px-4 py-2.5 text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F4A4C" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            Sin incapacidad
          </span>
        </div>
        <div class="flex flex-wrap gap-3 pt-1.5">
          <a href={WHATSAPP_URL} class="btn btn-primario">Reservar valoración gratis <Flecha /></a>
          <a href="#pasos" class="btn btn-secundario">Ver cómo funciona</a>
        </div>
      </div>
      <div class="relative">
        <Image
          src={s.foto}
          alt={s.fotoAlt}
          widths={[600, 900, 1200]}
          sizes="(min-width: 1200px) 552px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="block aspect-[5/6] w-full rounded-[28px] object-cover"
          style={{ background: s.tono }}
        />
        <div
          class="absolute top-7 right-3 box-border flex w-[250px] flex-col gap-2.5 rounded-[22px] bg-white px-6 py-[22px] shadow-[0_12px_32px_rgba(31,42,43,0.12)] lg:-right-3"
        >
          <span class="text-[13px] text-gris-2">Plan completo · {s.sesiones}</span>
          <span class="font-serif text-[44px] leading-none font-semibold text-tinta">{s.precio}</span>
          {
            s.antes && (
              <span class="text-sm text-gris-2">
                Antes <span class="line-through">{s.antes}</span> ·{' '}
                <strong class="text-terracota">{s.dcto}</strong>
              </span>
            )
          }
          <span class="border-t border-lino pt-2.5 text-sm text-gris">
            Financiación del 100% · Valoración sin costo
          </span>
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="bg-white px-6 py-[88px]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-10">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="titulo text-[clamp(36px,4vw,52px)] leading-[1.05]">Por qué <em>elegirlo</em></h2>
          <p class="m-0 max-w-[360px] text-[15px] leading-relaxed text-gris-2">
            Lo que obtienes con este tratamiento en Mariyen.
          </p>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
          {
            s.beneficios.map((b) => (
              <article class="flex flex-col gap-3 rounded-[22px] bg-crema p-[26px]">
                <span class="flex size-10 items-center justify-center rounded-full bg-white">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F4A4C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <h3 class="m-0 text-lg font-bold">{b.t}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-gris">{b.d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pasos -->
    <section id="pasos" class="scroll-mt-4 px-6 py-[88px]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-11">
        <h2 class="titulo text-[clamp(36px,4vw,52px)] leading-[1.05]">Tu proceso, <em>paso a paso</em></h2>
        <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-5 p-0">
          {
            s.pasos.map((p) => (
              <li class="flex flex-col gap-2.5 border-t border-linea pt-[22px]">
                <span class="font-serif text-[34px] text-petroleo italic">{p.n}</span>
                <h3 class="m-0 text-lg font-bold">{p.t}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-gris">{p.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Galería -->
    <section class="px-6 pb-[88px]">
      <div class="mx-auto grid max-w-[1200px] grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-4">
        {
          s.galeria.map((g, i) => (
            <Image
              src={g.src}
              alt={g.alt}
              widths={[400, 600, 800]}
              sizes="(min-width: 1200px) 384px, (min-width: 640px) 50vw, 100vw"
              class="block aspect-[4/5] w-full rounded-3xl object-cover"
              style={{ background: tonosGaleria[i % 3] }}
            />
          ))
        }
      </div>
    </section>

    <!-- Para ti / Ten en cuenta -->
    <section class="bg-white px-6 py-[88px]">
      <div class="mx-auto grid max-w-[1200px] grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-5">
        <div class="flex flex-col gap-4 rounded-3xl bg-menta p-8">
          <h3 class="m-0 font-serif text-[30px] font-semibold">Es para ti si…</h3>
          <ul class="m-0 flex list-disc flex-col gap-2.5 pl-5 text-base leading-[1.55]">
            {s.ideal.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="flex flex-col gap-4 rounded-3xl bg-rosa p-8">
          <h3 class="m-0 font-serif text-[30px] font-semibold">Ten en cuenta</h3>
          <ul class="m-0 flex list-disc flex-col gap-2.5 pl-5 text-base leading-[1.55]">
            {s.cuenta.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-6 py-[88px]">
      <div class="mx-auto flex max-w-[820px] flex-col gap-2">
        <h2 class="titulo mb-5 text-[clamp(36px,4vw,52px)] leading-[1.05]">Preguntas <em>frecuentes</em></h2>
        {
          s.faq.map((f) => (
            <details class="group rounded-[18px] bg-white px-6 py-5">
              <summary class="flex min-h-7 cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-bold [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg class="shrink-0 transition-transform group-open:rotate-45" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F4A4C" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3 mb-0 text-base leading-relaxed text-gris">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Otros tratamientos -->
    <section id="otros" class="scroll-mt-4 bg-white px-6 py-[88px]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
        <h2 class="titulo text-[clamp(36px,4vw,52px)] leading-[1.05]">Otros <em>tratamientos</em></h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
          {
            otros.map((o) => (
              <a
                href={urlServicio(o.slug)}
                class="group flex flex-col overflow-hidden rounded-[22px] bg-crema text-tinta no-underline hover:text-tinta"
              >
                <span class="block overflow-hidden" style={{ background: o.tono }}>
                  <Image
                    src={o.foto}
                    alt=""
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1200px) 384px, 100vw"
                    class="block aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </span>
                <span class="flex items-baseline justify-between gap-3 px-5 py-[18px]">
                  <span class="flex flex-col gap-1">
                    <span class="text-base font-bold group-hover:text-petroleo">{o.nombre}</span>
                    <span class="text-[13px] text-gris-2">{o.sesiones}</span>
                  </span>
                  <span class="font-serif text-2xl font-semibold">{o.precio}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CtaWhatsapp texto="Te decimos qué puedes lograr, cuántas sesiones necesitas y cuánto cuesta.">
      Empieza con una valoración <em>gratis</em>
    </CtaWhatsapp>
  </main>
  <Footer />
</Base>
