---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import Flecha from '../components/Flecha.astro';
import TituloAnimado from '../components/TituloAnimado.astro';
import PlanesDelMes from '../components/PlanesDelMes.astro';
import Preguntas from '../components/Preguntas.astro';
import FormasDePago from '../components/FormasDePago.astro';
import { servicios, destacados, complementarios, urlServicio, URL_OTROS } from '../data/servicios';
import { NEGOCIO, MENSAJE, FAQ_GENERAL, RESULTADOS, TESTIMONIOS, MAPA, precio, waValoracion } from '../data/site';

// Foto del hero (Unsplash, Aiony Haust). TODO(cliente): reemplazar por una foto real de la cabina o de la profesional.
import hero from '../assets/images/hero-retrato.jpg';
import cabinaVelas from '../assets/images/cabina-velas.jpg';
import masaje from '../assets/images/masaje.jpg';

const otrosPrincipales = servicios.filter((s) => !s.destacado);

const razones = [
  { t: 'Aparatología biomédica', d: 'Equipos especializados para trabajar cada zona con precisión.' },
  { t: 'Técnicas brasileñas', d: 'Masajes que complementan la aparatología en cada sesión.' },
  { t: 'Sin dolor, sin fajas, sin dietas', d: 'Sigues con tu rutina mientras avanzas en tu plan.' },
  { t: 'Más de 10 años', d: 'Experiencia y habilitación sanitaria al día.' },
];

const pasos = [
  { n: '01', t: 'Escríbenos', d: 'Por WhatsApp eliges el día y la hora de tu valoración.' },
  { n: '02', t: 'Valoración gratis', d: 'Revisamos tu caso y te damos un plan con número de sesiones y precio.' },
  { n: '03', t: 'Sesiones y seguimiento', d: 'Revisamos tu avance. Si no ves cambios, ajustamos tu plan.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_GENERAL.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Estética sin dolor ni fajas en Ubaté | Mariyen Centro de Estética"
  description="Centro de estética en Ubaté: aparatología biomédica y masajes brasileños sin dolor, sin fajas y sin dietas. Más de 10 años de experiencia y valoración gratis."
  jsonLd={[faqJsonLd]}
>
  <main>
    <!-- Hero -->
    <section class="p-4">
      <div
        class="intro-marco relative flex min-h-[calc(100svh-2rem)] flex-col overflow-hidden rounded-[32px] bg-niebla md:min-h-[max(760px,calc(100svh-2rem))] md:bg-bruma"
      >
        <!-- En escritorio la foto (vertical) ocupa el 60 % derecho para no ampliarse de más -->
        <div
          class="intro-zoom absolute inset-0 md:left-[50%] md:[mask-image:linear-gradient(90deg,transparent,black_30%)] lg:left-[40%]"
        >
          <Image
            src={hero}
            alt="Mujer con los ojos cerrados y expresión serena, apoyada en una mesa blanca con luz suave"
            class="parallax-hero absolute inset-0 h-full w-full object-cover object-[center_30%]"
            loading="eager"
            fetchpriority="high"
            widths={[828, 1280, 1920, 2400]}
            sizes="(max-width: 767px) 160vw, 62vw"
          />
        </div>
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[linear-gradient(180deg,rgba(244,247,246,0.94)_0%,rgba(244,247,246,0.86)_60%,rgba(244,247,246,0.35)_100%)] md:bg-[linear-gradient(90deg,rgba(244,247,246,1)_0%,rgba(244,247,246,1)_40%,rgba(244,247,246,0.7)_50%,rgba(244,247,246,0.15)_64%,rgba(244,247,246,0)_76%)]"
        >
        </div>
        <div class="intro-bajar relative z-10 px-4 pt-4">
          <Header class="max-w-[1180px]" />
        </div>
        <div
          class="relative mx-auto box-border flex w-full max-w-[1180px] flex-1 flex-wrap items-end justify-between gap-8 px-6 pt-12 pb-8 md:pt-[72px] md:pb-10"
        >
          <div class="flex max-w-[600px] flex-col gap-[22px]">
            <p class="intro-subir eyebrow text-texto-2" style="--d: 0.45s">
              Centro de estética en Ubaté, Cundinamarca
            </p>
            <TituloAnimado
              class="titulo text-[clamp(32px,4.4vw,58px)]"
              partes={[{ texto: MENSAJE.inicio }, { texto: MENSAJE.cierre, em: true }]}
            />
            <p class="intro-subir m-0 max-w-[500px] text-lg leading-relaxed text-texto-2" style="--d: 1.1s">
              {NEGOCIO.experiencia}, habilitación sanitaria al día y valoración gratis. Pagas en efectivo, por
              transferencia, a cuotas, con Addi o con Sistecrédito.
            </p>
            <div class="intro-subir flex flex-wrap gap-3" style="--d: 1.2s">
              <a href={waValoracion()} class="btn btn-primario">Agendar valoración gratis <Flecha /></a>
              <a href="#tratamientos" class="btn btn-secundario">Ver tratamientos</a>
            </div>
          </div>

          <!-- En escritorio la tarjeta va sobre la foto; en celular, debajo del hero -->
          <PlanesDelMes class="intro-derecha hidden max-w-[360px] md:flex" style="--d: 1.25s" />
        </div>
      </div>
      <PlanesDelMes class="revelar mt-4 flex md:hidden" />
    </section>

    <!-- Tratamientos -->
    <section id="tratamientos" class="scroll-mt-4 px-6 pt-16 pb-16 md:pt-24 md:pb-[88px]">
      <div class="mx-auto flex max-w-[1180px] flex-col gap-9">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <h2 class="titulo text-[clamp(30px,4vw,48px)]">Tratamientos <em>más recomendados</em></h2>
          <p class="m-0 max-w-[360px] text-[15px] leading-relaxed text-texto-3">
            Cada tratamiento empieza con una valoración gratis y un plan con precio claro desde el inicio.
          </p>
        </div>

        <!-- Destacados: los dos servicios que la clienta quiere impulsar -->
        <div class="grid gap-5 lg:grid-cols-2">
          {
            destacados.map((s) => (
              <article class="revelar group grid overflow-hidden rounded-3xl bg-white sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)]">
                <a href={urlServicio(s.slug)} class="relative block overflow-hidden sm:min-h-[240px]" style={{ background: s.tono }} tabindex="-1" aria-hidden="true">
                  <Image
                    src={s.foto}
                    alt=""
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1180px) 270px, (min-width: 640px) 45vw, 100vw"
                    transition:name={`foto-${s.slug}`}
                    class="block aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105 sm:absolute sm:inset-0 sm:aspect-auto sm:h-full"
                  />
                </a>
                <div class="flex flex-col gap-3 p-6">
                  <h3 class="m-0 font-display text-xl font-semibold">
                    <a href={urlServicio(s.slug)} class="text-petroleo no-underline hover:text-turquesa">
                      {s.nombre}
                    </a>
                  </h3>
                  <p class="m-0 text-[15px] leading-relaxed text-texto-2">{s.resumen}</p>
                  <p class="m-0 flex flex-wrap items-baseline gap-x-2">
                    <span class="precio text-2xl text-petroleo">{s.etiquetaPrecio}</span>
                    <span class="text-sm text-texto-3">{s.detallePrecio}</span>
                  </p>
                  <div class="mt-auto flex flex-wrap gap-2 pt-2">
                    <a href={waValoracion(s.enFrase)} class="btn btn-primario min-h-11 px-5 py-2.5 text-sm">
                      Agendar valoración
                    </a>
                    <a href={urlServicio(s.slug)} class="btn btn-secundario min-h-11 px-5 py-2.5 text-sm">
                      Ver detalles
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <!-- Otros servicios principales -->
        <div class="carrusel revelar grid-cols-2 gap-4">
          {
            otrosPrincipales.map((s) => (
              <a
                href={urlServicio(s.slug)}
                class="group flex items-center gap-4 rounded-3xl bg-white p-3 pr-5 text-petroleo no-underline hover:text-petroleo"
              >
                <Image
                  src={s.foto}
                  alt=""
                  width={192}
                  height={192}
                  transition:name={`foto-${s.slug}`}
                  class="size-24 shrink-0 rounded-2xl object-cover"
                />
                <span class="flex min-w-0 flex-col gap-1">
                  <span class="font-display text-lg font-semibold group-hover:text-turquesa">{s.nombre}</span>
                  <span class="text-sm text-texto-3">
                    <span class="precio text-base text-petroleo">{s.etiquetaPrecio}</span> · {s.detallePrecio}
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <!-- Complementarios -->
        <div class="revelar rounded-3xl bg-white p-6 md:p-8">
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="m-0 font-display text-xl font-semibold">Otros tratamientos</h3>
            <a href={URL_OTROS} class="text-sm font-semibold">Ver todos →</a>
          </div>
          <ul class="m-0 grid list-none gap-x-10 p-0 md:grid-cols-2">
            {
              complementarios.map((c) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-niebla py-3">
                  <span>
                    <span class="font-semibold">{c.nombre}</span>
                    {c.detalle && <span class="block text-sm text-texto-3">{c.detalle}</span>}
                  </span>
                  <span class="precio text-right text-petroleo">
                    {c.desde && <span class="font-sans text-sm font-medium text-texto-3">desde </span>}
                    {precio(c.valor)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Por qué Mariyen -->
    <section class="bg-white px-6 py-16 md:py-24">
      <div class="mx-auto flex max-w-[1180px] flex-col gap-10">
        <h2 class="titulo text-[clamp(30px,4vw,48px)]">Por qué <em>Mariyen</em></h2>
        <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4 p-0">
          {
            razones.map((r) => (
              <li class="revelar flex flex-col gap-3 rounded-3xl bg-bruma p-6">
                <span class="flex size-10 items-center justify-center rounded-full bg-agua text-petroleo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <h3 class="m-0 font-display text-lg font-semibold">{r.t}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-texto-2">{r.d}</p>
              </li>
            ))
          }
        </ul>
        <FormasDePago />
      </div>
    </section>

    <!-- Así empiezas -->
    <section class="px-6 py-16 md:py-24">
      <div class="mx-auto flex max-w-[1180px] flex-col gap-10">
        <h2 class="titulo text-[clamp(30px,4vw,48px)]">Así <em>empiezas</em></h2>
        <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-5 p-0">
          {
            pasos.map((p) => (
              <li class="revelar flex flex-col gap-2.5 border-t-2 border-agua pt-[22px]">
                <span class="font-display text-3xl font-semibold text-turquesa">{p.n}</span>
                <h3 class="m-0 text-lg font-bold">{p.t}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-texto-2">{p.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Preguntas frecuentes -->
    <Preguntas id="preguntas" items={FAQ_GENERAL} class="bg-white" />

    <!--
      TODO(cliente): resultados reales (antes y después) y testimonios, con autorización firmada.
      Las secciones se muestran solo cuando RESULTADOS o TESTIMONIOS de src/data/site.ts tengan datos.
    -->
    {
      (RESULTADOS.length > 0 || TESTIMONIOS.length > 0) && (
        <section id="resultados" class="scroll-mt-4 px-6 py-16 md:py-24">
          <div class="mx-auto flex max-w-[1180px] flex-col gap-8">
            <h2 class="titulo text-[clamp(30px,4vw,48px)]">
              Pacientes <em>reales</em>
            </h2>
            <p class="m-0 text-sm text-texto-3">Publicado con autorización. Los resultados varían según cada persona.</p>
          </div>
        </section>
      )
    }

    <!-- Sobre Mariyen (resumen) -->
    <section class="px-6 py-16 md:py-24">
      <div class="mx-auto grid max-w-[1180px] grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] items-center gap-12">
        <Image
          src={cabinaVelas}
          alt="Cabina del centro de estética con toallas enrolladas y velas encendidas"
          widths={[600, 900, 1200]}
          sizes="(min-width: 1180px) 566px, 100vw"
          class="revelar block aspect-[4/3] w-full rounded-[28px] bg-niebla object-cover"
        />
        <div class="revelar flex flex-col gap-5">
          <p class="eyebrow">{NEGOCIO.experiencia}</p>
          <h2 class="titulo text-[clamp(30px,4vw,48px)]">Honesta, profesional y <em>exigente con los resultados</em></h2>
          <p class="m-0 text-[17px] leading-[1.7] text-texto-2">
            Así nos describen nuestras clientas. Formación en Nogal, CIFES y laboratorios como Natasha Karnaskaya,
            Armeso y Pineda, con habilitación sanitaria al día.
          </p>
          <a href="/sobre-mariyen" class="font-semibold">Conoce a Mariyen →</a>
        </div>
      </div>
    </section>

    <!-- Visítanos -->
    <section class="bg-white px-6 py-16 md:py-24">
      <div class="mx-auto grid max-w-[1180px] grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] items-center gap-8">
        <div class="flex flex-col gap-6">
          <h2 class="titulo text-[clamp(30px,4vw,48px)]">Te esperamos <em>en Ubaté</em></h2>
          <dl class="m-0 flex flex-col gap-2.5">
            <div class="flex flex-col gap-1 rounded-[18px] bg-bruma px-[22px] py-4 sm:flex-row sm:justify-between sm:gap-4">
              <dt class="font-display font-semibold">Dirección</dt>
              <dd class="m-0 text-[15px] text-texto-2 sm:text-right">{NEGOCIO.direccion.completa}</dd>
            </div>
            <div class="flex flex-col gap-1 rounded-[18px] bg-bruma px-[22px] py-4 sm:flex-row sm:justify-between sm:gap-4">
              <dt class="font-display font-semibold">Horario</dt>
              <dd class="m-0 text-[15px] text-texto-2 sm:text-right">{NEGOCIO.horario.texto}</dd>
            </div>
            <div class="flex flex-col gap-1 rounded-[18px] bg-bruma px-[22px] py-4 sm:flex-row sm:justify-between sm:gap-4">
              <dt class="font-display font-semibold">WhatsApp</dt>
              <dd class="m-0 text-[15px]"><a href={waValoracion()}>{NEGOCIO.telefono.visible}</a></dd>
            </div>
          </dl>
          <div class="flex flex-wrap gap-3">
            <a href={MAPA.comoLlegar} class="btn btn-primario">Cómo llegar <Flecha /></a>
            <a href="/contacto" class="btn btn-secundario">Ver mapa y contacto</a>
          </div>
        </div>
        <div class="relative min-h-[320px] overflow-hidden rounded-[28px] bg-niebla md:min-h-[380px]">
          <Image
            src={masaje}
            alt="Masaje en la espalda en una camilla con luz cálida"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1180px) 574px, 100vw"
            class="parallax-suave absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <CtaWhatsapp>Tu primera valoración <em>es gratis</em></CtaWhatsapp>
  </main>
  <Footer />
</Base>
