---
import { MENSAJE } from '../data/site';
---

<!-- Mensaje central de marca, repetido en las páginas de servicio -->
<section class="px-4 sm:px-6" aria-label="Nuestro método">
  <p
    class="revelar mx-auto my-0 max-w-[1200px] rounded-3xl bg-petroleo px-6 py-8 text-center font-display text-[clamp(20px,2.6vw,30px)] leading-snug font-semibold text-white md:px-12 md:py-10"
  >
    {MENSAJE.inicio} <span class="text-agua">{MENSAJE.cierre}</span>
  </p>
</section>
