---
import { Image } from 'astro:assets';
import { destacados, urlServicio } from '../data/servicios';

interface Props {
  class?: string;
  style?: string;
}

const { class: clase = '', style } = Astro.props;
---

<div
  style={style}
  class:list={[
    'box-border w-full flex-col gap-1 rounded-3xl bg-white p-[22px] shadow-[0_16px_40px_rgba(15,62,66,0.14)]',
    clase,
  ]}
>
  <p class="m-0 flex items-baseline justify-between border-b border-niebla pb-2.5">
    <span class="font-display text-lg font-semibold">Planes que más recomendamos</span>
  </p>
  {
    destacados.map((s) => (
      <a
        href={urlServicio(s.slug)}
        class="flex items-center gap-3 border-b border-niebla py-3 text-petroleo no-underline hover:text-turquesa"
      >
        <Image src={s.foto} alt="" width={88} height={88} class="size-11 shrink-0 rounded-xl object-cover" />
        <span class="flex flex-1 flex-col">
          <span class="text-sm font-bold">{s.nombre}</span>
          <span class="text-xs text-texto-3">{s.detallePrecio}</span>
        </span>
        <span class="precio text-sm">{s.etiquetaPrecio}</span>
      </a>
    ))
  }
  <div class="flex items-center gap-3 pt-3 pb-0.5">
    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-rubor">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7A3B2C" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </span>
    <span class="flex flex-1 flex-col">
      <span class="text-sm font-bold">Valoración</span>
      <span class="text-xs text-texto-3">Sin costo y sin compromiso</span>
    </span>
    <span class="rounded-full bg-rubor px-3 py-1 text-xs font-bold text-rubor-texto">Gratis</span>
  </div>
</div>
