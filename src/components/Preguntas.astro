---
interface Props {
  items: { q: string; a: string }[];
  id?: string;
  class?: string;
  titulo?: string;
}

const { items, id, class: clase = '', titulo } = Astro.props;
---

<section id={id} class:list={['scroll-mt-4 px-6 py-16 md:py-24', clase]}>
  <div class="mx-auto flex max-w-[820px] flex-col gap-2">
    <h2 class="titulo mb-5 text-[clamp(30px,4vw,48px)]">
      {titulo ?? <Fragment>Preguntas <em>frecuentes</em></Fragment>}
    </h2>
    {
      items.map((f) => (
        <details class="group rounded-[18px] bg-bruma px-6 py-5">
          <summary class="flex min-h-7 cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg class="shrink-0 transition-transform group-open:rotate-45" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F6B6E" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="mt-3 mb-0 text-base leading-relaxed text-texto-2">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
